# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0


# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017/smartcare


# ---- Staff authentication ----
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Hospital Admin

# ---- Payment mode ----
# PAYMENT_MODE=demo

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Queue behaviour ----
# Minutes a patient has to finish paying before the reserved token is released.
RESERVATION_MINUTES=10
# Average consultation length used for the estimated-time calculation.
AVG_CONSULT_MIN=6
# Share of each department's daily tokens that can be booked online (rest = hospital counter).
ONLINE_SHARE=0.7
# Create the default 15 departments on first start when the database is empty.
AUTO_SEED=true

# ---- TinyFish web agent (optional) ----
TINYFISH_API_KEY=

# ---- Fetch.ai AI agents (optional) ----
AGENT_URL=http://localhost:8000

# ---- Groq AI ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
