# ---- SmartCare backend the agents talk to ----
SMARTCARE_API=http://localhost:5000/api
# Where patients open the web app (used for hand-off links, e.g. paid bookings in Razorpay mode)
SMARTCARE_WEB=http://localhost:5173

# ---- Agent identities (any long secret phrase; each agent derives its own address from it) ----
AGENT_SEED_PHRASE=change-me-to-a-long-secret-phrase

# ---- Concierge agent (the one users talk to) ----
CONCIERGE_PORT=8000
# false -> local REST only (default). true -> register a mailbox on Agentverse (needs a one-time Agentverse sign-in)
USE_MAILBOX=false

# ---- Groq LLM (optional, recommended: smarter symptom triage + answers; rules-only if no LLM key) ----
# Key: https://console.groq.com/keys  (free tier available)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- ASI:One LLM (optional backup, used only if Groq is empty or fails) ----
# Key: https://asi1.ai  (Developer -> API keys)
ASI1_API_KEY=
ASI1_MODEL=asi1-mini
