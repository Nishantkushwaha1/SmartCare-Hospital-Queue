{
  "name": "smartcare-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SmartCare OPD token & queue API (Express + MongoDB + Razorpay). Models live in ../database",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "setup": "npm install --no-audit --no-fund && npm --prefix ../client install --include=dev --no-audit --no-fund",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "npm --prefix ../database run seed",
    "seed:reset-admin": "npm --prefix ../database run seed:reset-admin",
    "postinstall": "npm --prefix ../database install --omit=dev --no-audit --no-fund",
    "build": "npm --prefix ../client install --include=dev --no-audit --no-fund && npm --prefix ../client run build",
    "render-build": "npm install && npm run build",
    "dev:client": "npm --prefix ../client run dev",
    "dev:all": "concurrently -n api,web -c green,cyan \"npm run dev\" \"npm run dev:client\"",
    "agents": "python agents/run_all.py",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "razorpay": "^2.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
